# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sentosa_cafe"

# Server configuration
PORT=4000
NODE_ENV=development

# JWT Authentication secret for restaurant admin/staff
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# Application URLs (Used for QR code generation and CORS)
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"

# Razorpay Payment Gateway Credentials (India)
# Get your test/live keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Sandbox demo mode (when true, enables built-in interactive Razorpay mock checkout for local testing without real keys)
RAZORPAY_MOCK_SANDBOX=true
