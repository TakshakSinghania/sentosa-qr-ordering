# ==============================================================================
# The Artisan Table - Frontend Client Environment Configuration (Vite)
# ==============================================================================

# Backend API base URL
# In local development with Vite dev server proxy, leave empty or set to /api
# In production if the frontend and backend are hosted on separate domains:
# VITE_API_URL="https://api.yourcafe.com"
VITE_API_URL=""

# Realtime WebSocket server URL
# In local development or unified Nginx domain, leave empty to default to current origin
# If hosted on a distinct backend server:
# VITE_WS_URL="https://api.yourcafe.com"
VITE_WS_URL=""
