# ==============================================================================
# The Artisan Table - QR Café Production & Staging Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# For AWS RDS, Supabase, Neon, Railway, or local Docker container.
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/qr_cafe?schema=public"

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# High-entropy JWT signing secret for café staff/admin sessions
# Generate a secure 64-char key using: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_48_for_secure_session_key"

# ------------------------------------------------------------------------------
# 3. APPLICATION & REVERSE PROXY URLS
# ------------------------------------------------------------------------------
# Public-facing domain where the customer ordering frontend is hosted.
# Used by the Table QR Code Generator to produce printable tabletop QR codes.
APP_URL="https://menu.yourcafe.com"

# Public-facing URL where this API server is reachable by browsers and webhooks.
API_URL="https://api.yourcafe.com"

# Comma-separated allowed origins for CORS (Admin dashboards, staging domains)
ALLOWED_ORIGINS="https://menu.yourcafe.com,https://admin.yourcafe.com,http://localhost:5173"

# ------------------------------------------------------------------------------
# 4. OFFICIAL RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain these credentials from https://dashboard.razorpay.com/#/app/keys
#
# FOR PRODUCTION / LIVE PAYMENTS:
#   RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
#   RAZORPAY_KEY_SECRET="your_live_key_secret"
#   RAZORPAY_MOCK_SANDBOX=false
#
# FOR TEST / STAGING / QA:
#   RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
#   RAZORPAY_KEY_SECRET="your_test_key_secret"
#   RAZORPAY_MOCK_SANDBOX=false
#
# FOR OFFLINE DEMO / SANDBOX-ONLY DEMONSTRATIONS:
#   Set RAZORPAY_MOCK_SANDBOX=true to permit one-click test payments without live keys.
RAZORPAY_KEY_ID="rzp_test_demokey12345"
RAZORPAY_KEY_SECRET="demosecretkey1234567890"

# Razorpay Webhook Secret configured at:
# https://dashboard.razorpay.com/#/app/webhooks -> Add New Webhook
# URL: https://api.yourcafe.com/api/payments/webhook
# Secret must match the value below:
RAZORPAY_WEBHOOK_SECRET="demowebhooksecret12345"

# Set to true to enforce mock sandbox mode even if real keys are supplied
RAZORPAY_MOCK_SANDBOX=false
